# Copy to Server/.env for local development (git-ignored). In production set real environment variables.
# Full connection string incl. credentials, e.g. mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=movie-api-db

# Comma-separated list of exact frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Set to "framework" only when running behind a trusted reverse proxy / load balancer
FORWARD_HEADERS_STRATEGY=none

RATE_LIMIT_READS_PER_MINUTE=120
RATE_LIMIT_WRITES_PER_MINUTE=10

# Seed the catalogue on first start if the Movies collection is empty
SEED_DATA=true
